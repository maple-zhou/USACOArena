{
  "api_base": "http://127.0.0.1:5000",
  "competition": {
    "title": "USACOArena Open Benchmark",
    "description": "Reproducible benchmark run",
    "problem_ids": [
      "1515_bronze_hoof_paper_scissors_minus_one",
      "1516_bronze_more_cow_photos"
    ],
    "max_tokens_per_participant": 100000,
    "rules": {
      "lambda": 100,
      "delivery_time_multiplier": 1,
      "intelligence_weights": {
        "solve": 0.45,
        "efficiency": 0.2,
        "reliability": 0.15,
        "speed": 0.1,
        "coverage": 0.1
      }
    }
  },
  "participants": [
    {
      "name": "codex-baseline",
      "api_base_url": "$ENV:OPENAI_BASE_URL",
      "api_key": "$ENV:OPENAI_API_KEY",
      "limit_tokens": 100000,
      "lambda_value": 100,
      "request_format": {
        "url": "/v1/chat/completions",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {api_key}"
        },
        "body_template": {
          "messages": "{messages}",
          "model": "{model_id}"
        }
      },
      "response_format": {
        "response_path": "choices[0].message.content",
        "error_path": "error.message"
      },
      "agent_profile": {
        "version": "1.0",
        "agent_type": "codex",
        "transport": "openai_compatible_http",
        "entrypoint": "",
        "capabilities": [
          "read_problem",
          "submit_solution",
          "test_code"
        ],
        "mcp": {
          "enabled": false,
          "servers": []
        },
        "request_format": {},
        "response_format": {},
        "metadata": {}
      }
    },
    {
      "name": "claude-baseline",
      "api_base_url": "$ENV:ANTHROPIC_BASE_URL",
      "api_key": "$ENV:ANTHROPIC_API_KEY",
      "limit_tokens": 100000,
      "lambda_value": 100,
      "request_format": {
        "url": "/v1/messages",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "x-api-key": "{api_key}",
          "anthropic-version": "2023-06-01"
        },
        "body_template": {
          "model": "{model_id}",
          "max_tokens": 4096,
          "messages": "{messages}"
        }
      },
      "response_format": {
        "response_path": "content[0].text",
        "error_path": "error.message",
        "usage_path": "usage"
      },
      "agent_profile": {
        "version": "1.0",
        "agent_type": "claude_code",
        "transport": "openai_compatible_http",
        "entrypoint": "",
        "capabilities": [
          "read_problem",
          "submit_solution",
          "test_code",
          "mcp_tools"
        ],
        "mcp": {
          "enabled": true,
          "servers": []
        },
        "request_format": {},
        "response_format": {},
        "metadata": {}
      }
    }
  ],
  "report": {
    "output_dir": "reports/intelligence",
    "weights": {
      "solve": 0.45,
      "efficiency": 0.2,
      "reliability": 0.15,
      "speed": 0.1,
      "coverage": 0.1
    }
  }
}
