{
  "competitors": [
    {
      "type": "generic",
      "name": "gemini-2.5-pro",
      "model_id": "gemini-2.5-pro",
      "api_base_url": "https://generativelanguage.googleapis.com/openai",
      "api_key": "",
      "prompt_config_path": "agents/single_agent/prompts/prompts-main.json",
      "request_format": {
        "url": "/v1beta/openai/chat/completions",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {api_key}"
        },
        "body_template": {
          "messages": "{messages}",
          "model": "{model_id}",
          "temperature": 0.7
        }
      },
      "response_format": {
        "response_path": "choices[0].message.content",
        "error_path": "error.message"
      },
      "api_base_url_env": "GEMINI_BASE_URL",
      "api_key_env": "GEMINI_API_KEY"
    }
  ]
}
